;; playthrough.scm — one full run of the three-act story, used as the demo
;; video script. It walks and talks like a player (GM only sets the clock speed
;; and pauses it while reading); every milestone also lets the real story beat
;; fire so the cutscenes are part of the recording.

(define (acceptance:steps)
  (list
    (list "note" "《渡口》完整通关：从河滩出生，修船料 → 查线索 → 接缆绳 → 渡船重开" "3.2")
    (list "gm" "speed 0")
    (list "place" "village" "village:riverbank")
    (list "assert-map" "village")

    (list "note" "第一幕：沿村道往北进铁匠铺，找老王接下找矿石的活儿" "2.8")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "wait" "0.4")
    (list "walk" "smith-stand")
    (list "press" "E")
    (list "topic" "quest")
    (list "assert-quest" "smith-ore" "accepted")
    (list "close-dialog")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "wait" "0.4")

    (list "note" "河边和村西散落着三块铁矿石，走到两格内会自动入包" "3.0")
    (list "walk" "ore-1")
    (list "wait" "0.5")
    (list "walk" "ore-2")
    (list "wait" "0.5")
    (list "walk" "ore-3")
    (list "wait" "0.6")
    (list "assert-bag" "item/material/ore" "3")

    (list "note" "矿石齐了，回铁匠铺交给老王，他会重铸绞盘" "2.8")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "wait" "0.4")
    (list "walk" "smith-stand")
    (list "press" "E")
    (list "topic" "give")
    (list "assert-quest" "smith-ore" "completed")
    (list "close-dialog")
    (list "gm" "speed 1")
    (list "wait" "1.6")
    (list "assert-story-fact" "ford.winch-ready" "1")
    (list "story-skip")
    (list "gm" "speed 0")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "wait" "0.4")

    (list "note" "第二幕：去旅店找张掌柜，问清渡船断了对岸的事" "2.8")
    (list "walk" "inn-yard")
    (list "press" "E")
    (list "topic" "quest")
    (list "close-dialog")
    (list "press" "E")
    (list "topic" "quest")
    (list "close-dialog")
    (list "note" "河滩上的泥印和断口整齐的缆绳，是张掌柜说的两处痕迹" "2.8")
    (list "walk" "river-mud")
    (list "press" "E")
    (list "walk" "rope-end")
    (list "press" "E")
    (list "assert-quest" "clues" "completed")
    (list "gm" "speed 1")
    (list "wait" "1.5")
    (list "assert-story-fact" "ford.clues-done" "1")
    (list "story-skip")
    (list "gm" "speed 0")

    (list "note" "第三幕：回铁匠铺接修船任务，先问阿笋为什么剪缆绳" "3.0")
    (list "gm" "heal")  ; the demo must not end in a slime death
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "wait" "0.4")
    (list "walk" "smith-stand")
    (list "press" "E")
    (list "topic" "quest")
    (list "assert-quest" "ferry" "accepted")
    (list "close-dialog")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "wait" "0.4")
    (list "walk" "axun-spot")
    (list "press" "E")
    (list "close-dialog")
    (list "note" "阿笋怕父亲留下的渡船被拖走。真相说清了，去河滩接好新缆绳" "3.0")
    (list "gm" "heal")
    (list "walk" "winch")
    (list "press" "E")
    (list "assert-quest" "ferry" "completed")
    (list "gm" "speed 1")
    (list "wait" "1.8")
    (list "assert-story-fact" "ford.ferry-open" "1")
    ;; Leave the final cutscene on screen: that is the last shot of the video.
    (list "note" "结局：第一班渡船重开，信送到了对岸。" "6.0")))

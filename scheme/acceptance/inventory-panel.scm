;;; Phase 6.2 验收：背包面板（I 键）。
;;; GM 中输入：load inventory-panel
;;;
;;; 按人玩的节奏：从河口出生点走村道去铁匠铺，进屋开箱拿斧头，按 I 打开
;;; 面板看网格；面板开着时用 GM `give` 往背包塞石头，网格应当立刻刷新；
;;; 关面板出屋砍树，再开面板确认原木也上了网格；最后去村西捡矿石。
;;; 断言读的是面板自己画出来的格子（bag_ui.slot_total / filled_slots），
;;; 不是 Scheme 的背包视图，所以面板停在旧数据上会失败。
;;; 脚本不还原场景：跑完后斧头、石头、原木和矿石都留在背包里。

(define (acceptance:steps)
  (list
    (list "note" "Phase 6.2：背包面板。午饭点的村子，从河南岸的滩上走进村" "2.6")
    (list "gm" "speed 0")
    (list "gm" "time 12:30")
    (list "place" "village" "village:riverbank")
    (list "assert-map" "village")
    (list "note" "沿村道往北到铁匠铺门口，按方向键进屋" "2.0")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "assert-map" "smithy")
    (list "wait" "0.4")
    (list "note" "走到箱子旁按 E 开箱，点击斧头把它移进背包" "1.8")
    (list "walk-interact")
    (list "assert-container" "open")
    (list "click-item" "chest" "item/tool/axe")
    (list "assert-bag" "item/tool/axe" "1")
    (list "press" "E")
    (list "assert-container" "closed")
    (list "note" "按 I 打开背包面板：三行十格，斧头占第一格，金色边框表示手持" "2.6")
    (list "press" "I")
    (list "assert-panel" "open")
    (list "assert-panel-item" "item/tool/axe" "1")
    (list "assert-panel-slots" "1")
    (list "wait" "0.3")
    (list "assert-panel-icons")
    (list "note" "面板开着时往背包塞 3 块石头：不用关面板，网格应当立刻多出一格" "2.6")
    (list "gm" "give stone 3")
    (list "wait" "0.5")
    (list "assert-panel-item" "item/material/stone" "3")
    (list "assert-panel-slots" "2")
    (list "assert-bag" "item/material/stone" "3")
    (list "note" "按 I 关掉面板，走回门口出屋" "1.8")
    (list "press" "I")
    (list "assert-panel" "closed")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "assert-map" "village")
    (list "wait" "0.4")
    (list "note" "门口正上方就是那道门，先侧身让开一步再往树那边走" "1.8")
    (list "key" "move_left" "0.4")
    (list "note" "走到门口上方那棵树旁，第一斧" "1.8")
    (list "walk-use")
    (list "wait" "0.6")
    (list "note" "补一斧把树砍倒，两根原木磁吸进背包" "1.8")
    (list "use")
    (list "wait" "0.9")
    (list "assert-bag" "item/material/log" "2")
    (list "note" "再按 I：斧头 / 石头 / 原木各占一格，面板与背包栈一致" "2.4")
    (list "press" "I")
    (list "assert-panel" "open")
    (list "assert-panel-item" "item/material/log" "2")
    (list "assert-panel-item" "item/material/stone" "3")
    (list "assert-panel-slots" "3")
    (list "note" "按 I 收起面板，绕到村西老王家门口捡最后一块矿石" "2.0")
    (list "press" "I")
    (list "assert-panel" "closed")
    (list "walk" "smith-home")
    (list "assert-near" "smith-home")
    (list "wait" "0.6")
    (list "assert-bag" "item/material/ore" "1")
    (list "note" "按 I：矿石也上网格，四类物品正好四格" "2.2")
    (list "press" "I")
    (list "assert-panel" "open")
    (list "assert-panel-item" "item/material/ore" "1")
    (list "assert-panel-slots" "4")
    (list "note" "再按一次 I 关闭面板，验收完成" "1.8")
    (list "press" "I")
    (list "assert-panel" "closed")
    (list "note" "GM 也可以直接开关面板：bag open / bag close" "1.8")
    (list "gm" "bag open")
    (list "assert-panel" "open")
    (list "gm" "bag close")
    (list "assert-panel" "closed")
    (list "gm" "speed 1")
    (list "note" "验收完成：面板与背包栈一致，开面板时的入包会即时刷新" "2.4")))

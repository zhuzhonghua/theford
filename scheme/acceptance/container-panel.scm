;;; Phase 6.3 验收：容器面板（开箱子，点击转移）。
;;; GM 中输入：load container-panel
;;;
;;; 按人玩的节奏：从河口出生点走村道去铁匠铺，进屋走到箱子旁按 E。
;;; 面板同时显示箱子和背包：点击斧头整堆移进背包，箱子空出来；再用 GM
;;; 塞石头和矿石，验证“点击整堆”与“Shift+点击一个”两个方向都能走。
;;; 最后 Esc / E 关闭面板，再按 E 打开，确认空箱子只显示八个格子。
;;; 脚本不还原场景：跑完后斧头、石头和矿石都留在背包里。

(define (acceptance:steps)
  (list
    (list "note" "Phase 6.3：容器面板。午饭点的村子，从河南岸的滩上走进村" "2.6")
    (list "gm" "speed 0")
    (list "gm" "time 12:30")
    (list "place" "village" "village:riverbank")
    (list "assert-map" "village")
    (list "note" "沿村道往北到铁匠铺门口，按方向键进屋" "2.0")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "assert-map" "smithy")
    (list "wait" "0.4")
    (list "note" "走到箱子旁按 E：箱子和背包同时显示，斧头还在箱子里" "2.4")
    (list "walk-interact")
    (list "assert-container" "open")
    (list "assert-container-item" "item/tool/axe" "1")
    (list "assert-container-slots" "1")
    (list "assert-bag" "item/tool/axe" "0")
    (list "wait" "0.3")
    (list "assert-container-icons")
    (list "note" "点击箱子里的斧头：整堆移到背包，箱子空出来" "2.4")
    (list "click-item" "chest" "item/tool/axe")
    (list "assert-container-item" "item/tool/axe" "0")
    (list "assert-container-slots" "0")
    (list "assert-bag" "item/tool/axe" "1")
    (list "assert-bag-slots" "1")
    (list "note" "往背包塞 3 块石头，点击背包里的石头：整堆放进箱子" "2.4")
    (list "gm" "give stone 3")
    (list "wait" "0.4")
    (list "click-item" "bag" "item/material/stone")
    (list "assert-container-item" "item/material/stone" "3")
    (list "assert-container-slots" "1")
    (list "assert-bag" "item/material/stone" "0")
    (list "note" "点击箱子里的石头：又整堆回到背包，箱子再次清空" "2.2")
    (list "click-item" "chest" "item/material/stone")
    (list "assert-container-item" "item/material/stone" "0")
    (list "assert-bag" "item/material/stone" "3")
    (list "note" "再塞 3 块矿石，Shift+点击只移一个进箱子" "2.4")
    (list "gm" "give ore 3")
    (list "wait" "0.4")
    (list "click-item" "bag" "item/material/ore" "one")
    (list "assert-container-item" "item/material/ore" "1")
    (list "assert-bag" "item/material/ore" "2")
    (list "note" "点击箱子里的那一个矿石：也回到背包" "2.2")
    (list "click-item" "chest" "item/material/ore")
    (list "assert-container-item" "item/material/ore" "0")
    (list "assert-bag" "item/material/ore" "3")
    (list "note" "按 E 关闭面板：箱子回到关闭状态，里面已经空了" "2.2")
    (list "press" "E")
    (list "assert-container" "closed")
    (list "note" "再按 E 打开：空箱子只显示八个格子，没有物品" "2.2")
    (list "interact")
    (list "assert-container" "open")
    (list "assert-container-slots" "0")
    (list "note" "最后按 E 收起面板，验收完成" "1.8")
    (list "press" "E")
    (list "assert-container" "closed")
    (list "gm" "speed 1")
    (list "note" "验收完成：点击整堆、Shift 点击一个、关闭与重开都通过" "2.4")))

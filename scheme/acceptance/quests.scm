;;; Phase 8 验收：通用任务系统（双任务并行 + 目标对象 + 日志 + 奖励）。
;;; GM 中输入：load quests
;;;
;;; 两条任务线都按“人玩”的节奏走：走到 NPC 面前按 E 开对话、用话题推进，
;;; 走到药圃逐株采草药、回 NPC 交付；矿石捡拾这一段由 bag-pickup 覆盖，
;;; 这里用 GM give 直接注入，直奔任务判定。
;;; 断言读 Scheme 的 game:quests 视图与 J 面板实际绘制的行，避免“看着像对了”。

(define (acceptance:steps)
  (list
    (list "note" "Phase 8：验收先暂停时间让 NPC 站定，画面静止是正常的（右上角显示步骤进度）。两条任务开局都还没接" "2.4")
    (list "gm" "speed 0")
    (list "place" "village" "village:riverbank")
    (list "assert-map" "village")
    (list "assert-quest" "smith-ore" "not-offered")
    (list "assert-quest" "apothecary-herbs" "not-offered")
    (list "assert-xp" "0")

    (list "note" "先走村道进铁匠铺，接老王的矿石任务（老任务链回归）" "2.4")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "assert-map" "smithy")
    (list "wait" "0.4")
    (list "walk" "smith-stand")
    (list "press" "E")
    (list "topic" "quest")
    (list "assert-quest" "smith-ore" "accepted")
    (list "press" "E")

    (list "note" "矿石捡拾在 bag-pickup 里已经验过，这里注入 3 块直奔交付" "2.4")
    (list "gm" "give ore 3")
    (list "press" "E")
    (list "topic" "give")
    (list "assert-quest" "smith-ore" "completed")
    (list "assert-quest-progress" "smith-ore" "0" "3" "3")
    (list "assert-xp" "30")
    (list "assert-bag" "item/weapon/iron-sword" "1")
    (list "press" "E")

    (list "note" "出屋回村，去找陈婆接草药任务" "2.4")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "assert-map" "village")
    (list "wait" "0.4")
    (list "walk" "apothecary-stand")
    (list "press" "E")
    (list "topic" "quest")
    (list "assert-quest" "apothecary-herbs" "accepted")
    (list "assert-quest-progress" "apothecary-herbs" "0" "0" "1")
    (list "note" "第一个目标是『talk』：再问一次就把任务推进到采药阶段" "2.6")
    (list "topic" "quest")
    (list "assert-quest-progress" "apothecary-herbs" "0" "1" "1")
    (list "assert-quest" "apothecary-herbs" "accepted")
    (list "assert-quest-progress" "apothecary-herbs" "1" "0" "5")
    (list "press" "E")

    (list "note" "走到药圃逐株采草药；路过的几株也会被磁吸收进包" "2.6")
    (list "walk" "herb-1")
    (list "walk" "herb-2")
    (list "walk" "herb-3")
    (list "walk" "herb-4")
    (list "walk" "herb-5")
    (list "wait" "0.6")
    (list "assert-bag" "item/material/herb" "6")

    (list "note" "按 J 开任务日志：两条任务都在，进度和 XP 来自同一份 Scheme 视图" "2.6")
    (list "press" "J")
    (list "assert-quest-panel" "open")
    (list "assert-quest-panel-state" "smith-ore" "completed")
    (list "assert-quest-panel-state" "apothecary-herbs" "accepted")
    (list "assert-quest-panel-text" "apothecary-herbs" "0 / 5")
    (list "press" "J")
    (list "assert-quest-panel" "closed")

    (list "note" "回陈婆身边交草药：xp +20、奖励干粮入包，两条任务都完成" "2.6")
    (list "walk" "apothecary-stand")
    (list "press" "E")
    (list "topic" "give")
    (list "assert-quest" "apothecary-herbs" "completed")
    (list "assert-quest-progress" "apothecary-herbs" "1" "5" "5")
    (list "assert-xp" "50")
    (list "assert-bag" "item/food/meat" "2")
    (list "press" "E")

    (list "note" "再开一次日志，确认两条任务都显示已完成" "2.4")
    (list "press" "J")
    (list "assert-quest-panel-state" "smith-ore" "completed")
    (list "assert-quest-panel-state" "apothecary-herbs" "completed")
    (list "press" "J")
    (list "gm" "speed 1")
    (list "note" "验收完成：通用引擎驱动两条任务，目标/日志/奖励都对" "2.4")))

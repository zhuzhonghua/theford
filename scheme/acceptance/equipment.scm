;;; Phase 6.4 验收：装备槽（手中工具）。
;;; GM 中输入：load equipment
;;;
;;; 核心：F 动词用的是「装备槽里的工具」，不是「背包里有斧头」。
;;; 拿起斧头只进背包，F 砍不动；在背包里点工具格装备后 F 才生效；
;;; 卸下后同一把斧头还在包里，F 又失效。断言读 Scheme 的手槽
;;; （assert-held）与实体 HP，所以「没装备却砍得动」会当场失败。
;;; 按人玩的节奏：走村道进屋开箱，回村砍树，全程用 I 面板和 GM 装备。
;;; 脚本不还原场景，跑完后玩家可以继续玩。

(define (acceptance:steps)
  (list
    (list "note" "Phase 6.4：装备槽。开局两手空空，F 砍不了树" "2.4")
    (list "gm" "speed 0")
    (list "place" "village" "village:riverbank")
    (list "assert-map" "village")
    (list "assert-held" "")
    (list "note" "沿村道往北到铁匠铺门口，按方向键进屋" "1.8")
    (list "walk" "smithy-door")
    (list "move" "move_up" "smithy")
    (list "assert-map" "smithy")
    (list "wait" "0.4")
    (list "note" "走到箱子旁按 E 开箱，点击斧头移进背包" "1.8")
    (list "walk-interact")
    (list "assert-container" "open")
    (list "click-item" "chest" "item/tool/axe")
    (list "assert-bag" "item/tool/axe" "1")
    (list "note" "关键：斧头在背包里，但手槽还是空的——现在 F 砍不动" "2.8")
    (list "assert-held" "")
    (list "press" "E")
    (list "assert-container" "closed")
    (list "note" "回村口走到树旁，先不装备按 F：树仍是满血 6 点" "2.6")
    (list "walk" "door")
    (list "move" "move_down" "village")
    (list "assert-map" "village")
    (list "wait" "0.4")
    (list "key" "move_left" "0.4")
    (list "walk-use")
    (list "assert-last-entity-type" "fixture/tree")
    (list "assert-last-entity-hp" "6")
    (list "note" "按 I 开背包，面板顶部的『手』槽位是空的；点斧头格装备它" "2.8")
    (list "press" "I")
    (list "assert-panel" "open")
    (list "click-bag-item" "item/tool/axe")
    (list "assert-held" "item/tool/axe")
    (list "assert-panel-item" "item/tool/axe" "1")
    (list "press" "I")
    (list "assert-panel" "closed")
    (list "note" "装备好了：再按 F，斧头砍掉 3 点血，树 6→3" "2.4")
    (list "use")
    (list "assert-last-entity-hp" "3")
    (list "note" "再开背包点斧头卸下（手槽清空，斧头仍在包里），F 又失效" "2.8")
    (list "press" "I")
    (list "click-bag-item" "item/tool/axe")
    (list "assert-held" "")
    (list "assert-panel-item" "item/tool/axe" "1")
    (list "press" "I")
    (list "use")
    (list "assert-last-entity-hp" "3")
    (list "note" "GM `equip axe` 把斧头重新装回手槽，F 又能砍了" "2.4")
    (list "gm" "equip axe")
    (list "assert-held" "item/tool/axe")
    (list "note" "补最后一斧：树倒成树桩，两根原木磁吸进背包" "2.0")
    (list "use")
    (list "wait" "0.9")
    (list "assert-last-entity-type" "fixture/stump")
    (list "assert-last-entity-hp" "0")
    (list "assert-bag" "item/material/log" "2")
    (list "gm" "speed 1")
    (list "note" "验收完成：装备则 F 生效，未装备则 F 无效" "2.4")))

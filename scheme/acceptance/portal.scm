;;; 铁匠铺 portal 验收。GM 中输入：load portal

(define (portal-round-trip label)
  (list
    (list "note" label "2.0")
    (list "note" "持续输入 W → 铁匠铺" "1.2")
    (list "move" "move_up" "smithy")
    (list "note" "已进入铁匠铺：落点在门口" "1.0")
    (list "assert-map" "smithy")
    (list "wait" "0.5")
    (list "assert-near" "door")
    (list "wait" "0.4")
    (list "assert-npc" "smith" "forge")
    (list "note" "老王在锻造台附近" "1.0")
    (list "wait" "0.8")
    (list "note" "持续输入 S → 回到村庄" "1.2")
    (list "move" "move_down" "village")
    (list "note" "已回到村庄门口" "1.0")
    (list "assert-map" "village")
    (list "wait" "0.5")
    (list "assert-near" "smithy-door")
    (list "wait" "0.5")))

(define (acceptance:steps)
  (append
    (list
      (list "note" "铁匠铺 portal 验收：先放到河滩，再走到门口反复进出" "2.4")
      (list "note" "GM > time 09:00" "1.0")
      (list "gm" "time 09:00")
      (list "gm" "speed 0")
      (list "place" "village" "village:riverbank")
      (list "assert-map" "village")
      (list "note" "沿村道走到铁匠铺门口（看走位）" "1.8")
      (list "walk" "smithy-door")
      (list "wait" "0.5")
      (list "note" "邻格回归：从门柱旁向上走，不应进入" "2.0")
      (list "key" "move_left" "0.25")
      (list "wait" "0.3")
      (list "key" "move_up" "0.4")
      (list "wait" "0.6")
      (list "assert-map" "village")
      (list "wait" "0.4")
      (list "note" "回到门口，准备开始 round trip" "1.2")
      (list "walk" "smithy-door")
      (list "wait" "0.5"))
    (portal-round-trip "第 1 轮：W 进屋，S 回村")
    (portal-round-trip "第 2 轮：反复穿梭仍然可靠")
    (portal-round-trip "第 3 轮：入口与落点再检查一次")
    (list
      (list "gm" "speed 1")
      (list "note" "验收完成：可以关闭面板并继续手动跑图" "2.5"))))
